# The application carries its version in its name (pxs/docs/conventions.md): "OSCQlock 0.1.0" for a release, "OSCQlock 0.1.0+3" three commits after
# it, "OSCQlock 0.1.0+3+" with changes not committed. A tag built by CI is the release itself.
set(_root "${CMAKE_CURRENT_LIST_DIR}/..")
set(_release FALSE)
if("$ENV{GITHUB_REF_TYPE}" STREQUAL "tag")
  set(_release TRUE)
  set(OSCQLOCK_BASE_VERSION "$ENV{GITHUB_REF_NAME}")
else()
  execute_process(COMMAND git describe --tags --abbrev=0 --match "v[0-9]*" --match "[0-9]*" HEAD
    WORKING_DIRECTORY "${_root}" OUTPUT_VARIABLE OSCQLOCK_BASE_VERSION OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(OSCQLOCK_BASE_VERSION STREQUAL "")
    file(STRINGS "${_root}/VERSION" OSCQLOCK_BASE_VERSION LIMIT_COUNT 1)
  endif()
endif()
string(REGEX REPLACE "^v" "" OSCQLOCK_BASE_VERSION "${OSCQLOCK_BASE_VERSION}")
if(NOT OSCQLOCK_BASE_VERSION MATCHES "^([0-9]+)[.]([0-9]+)([.]([0-9]+))?([-+][0-9A-Za-z.-]+)?$")
  message(FATAL_ERROR "Invalid release version: ${OSCQLOCK_BASE_VERSION}")
endif()
set(OSCQLOCK_VERSION_NUMERIC "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}.0")
if(NOT "${CMAKE_MATCH_4}" STREQUAL "")
  set(OSCQLOCK_VERSION_NUMERIC "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}.${CMAKE_MATCH_4}")
endif()
set(OSCQLOCK_VERSION "${OSCQLOCK_BASE_VERSION}")
if(NOT _release)
  include("${CMAKE_CURRENT_LIST_DIR}/../third_party/pxs-qt/cmake/PixelStereoBuildId.cmake")
  pxs_build_suffix("${_root}" _suffix)
  string(APPEND OSCQLOCK_VERSION "${_suffix}")
endif()
set(OSCQLOCK_APP_NAME "OSCQlock ${OSCQLOCK_VERSION}")
message(STATUS "Application: ${OSCQLOCK_APP_NAME}")
